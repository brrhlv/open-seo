exports[`buildSavedKeywordsSeedSql > normalizes, quotes and orders the statements 1`] = `
"-- Saved keywords seed for project proj-1 (2 candidates).
-- Idempotent: re-running adds nothing new and never overwrites newer metrics.
-- Generated by scripts/saved-keywords-seed-sql.ts.
INSERT OR IGNORE INTO saved_keyword_tags (id, project_id, name, normalized_name) VALUES ('id-1', 'proj-1', 'blog-idea', 'blog-idea');
INSERT OR IGNORE INTO saved_keyword_tags (id, project_id, name, normalized_name) VALUES ('id-2', 'proj-1', 'page:/law-firm''s-events', 'page:/law-firm''s-events');
INSERT OR IGNORE INTO saved_keyword_tags (id, project_id, name, normalized_name) VALUES ('id-3', 'proj-1', 'cluster:corporate-events', 'cluster:corporate-events');
INSERT OR IGNORE INTO saved_keywords (id, project_id, keyword, location_code, language_code) VALUES ('id-4', 'proj-1', 'law firm''s holiday  party', 2840, 'en');
INSERT INTO keyword_metrics (project_id, keyword, location_code, language_code, search_volume, cpc, keyword_difficulty, intent, monthly_searches, fetched_at) VALUES ('proj-1', 'law firm''s holiday  party', 2840, 'en', 90, 1.5, 4, 'commercial', '[{"year":2026,"month":10,"searchVolume":90}]', '2026-11-03T07:27:39.000Z') ON CONFLICT (project_id, keyword, location_code, language_code) DO UPDATE SET search_volume = excluded.search_volume, cpc = excluded.cpc, keyword_difficulty = excluded.keyword_difficulty, intent = excluded.intent, monthly_searches = excluded.monthly_searches, fetched_at = excluded.fetched_at WHERE excluded.fetched_at > keyword_metrics.fetched_at;
INSERT OR IGNORE INTO saved_keyword_tag_assignments (saved_keyword_id, tag_id) SELECT k.id, t.id FROM saved_keywords k, saved_keyword_tags t WHERE k.project_id = 'proj-1' AND k.keyword = 'law firm''s holiday  party' AND k.location_code = 2840 AND k.language_code = 'en' AND t.project_id = 'proj-1' AND t.normalized_name = 'blog-idea';
INSERT OR IGNORE INTO saved_keyword_tag_assignments (saved_keyword_id, tag_id) SELECT k.id, t.id FROM saved_keywords k, saved_keyword_tags t WHERE k.project_id = 'proj-1' AND k.keyword = 'law firm''s holiday  party' AND k.location_code = 2840 AND k.language_code = 'en' AND t.project_id = 'proj-1' AND t.normalized_name = 'page:/law-firm''s-events';
INSERT OR IGNORE INTO saved_keywords (id, project_id, keyword, location_code, language_code) VALUES ('id-5', 'proj-1', 'casino night event', 2840, 'en');
INSERT INTO keyword_metrics (project_id, keyword, location_code, language_code, search_volume, cpc, keyword_difficulty, intent, monthly_searches, fetched_at) VALUES ('proj-1', 'casino night event', 2840, 'en', 1000, NULL, NULL, NULL, '[]', '2026-11-03T07:27:39.000Z') ON CONFLICT (project_id, keyword, location_code, language_code) DO UPDATE SET search_volume = excluded.search_volume, cpc = excluded.cpc, keyword_difficulty = excluded.keyword_difficulty, intent = excluded.intent, monthly_searches = excluded.monthly_searches, fetched_at = excluded.fetched_at WHERE excluded.fetched_at > keyword_metrics.fetched_at;
INSERT OR IGNORE INTO saved_keyword_tag_assignments (saved_keyword_id, tag_id) SELECT k.id, t.id FROM saved_keywords k, saved_keyword_tags t WHERE k.project_id = 'proj-1' AND k.keyword = 'casino night event' AND k.location_code = 2840 AND k.language_code = 'en' AND t.project_id = 'proj-1' AND t.normalized_name = 'blog-idea';
INSERT OR IGNORE INTO saved_keyword_tag_assignments (saved_keyword_id, tag_id) SELECT k.id, t.id FROM saved_keywords k, saved_keyword_tags t WHERE k.project_id = 'proj-1' AND k.keyword = 'casino night event' AND k.location_code = 2840 AND k.language_code = 'en' AND t.project_id = 'proj-1' AND t.normalized_name = 'cluster:corporate-events';
"
`;
